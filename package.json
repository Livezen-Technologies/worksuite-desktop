{
  "name": "worksuite-desktop",
  "productName": "WorkSuite",
  "version": "0.2.98",
  "description": "WorkSuite Desktop — the native desktop client for the WorkSuite platform (Windows, macOS, Linux).",
  "author": "Livezen Technologies",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://worksuite.lk",
  "main": "out/main/index.js",
  "scripts": {
    "localization:report": "node scripts/localization.mjs --write",
    "localization:release-check": "node scripts/localization.mjs --release",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs watch",
    "check": "npm run typecheck && npm run lint && npm run test",
    "module": "node scripts/module.mjs",
    "dist": "npm run build && electron-builder --config build/electron-builder.config.cjs",
    "dist:dir": "npm run build && electron-builder --config build/electron-builder.config.cjs --dir",
    "dist:mac": "npm run build && electron-builder --config build/electron-builder.config.cjs --mac",
    "dist:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config build/electron-builder.config.cjs --mac dmg:universal -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "dist:win": "npm run build && electron-builder --config build/electron-builder.config.cjs --win",
    "dist:linux": "npm run build && electron-builder --config build/electron-builder.config.cjs --linux",
    "release:keygen": "node scripts/release-keygen.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "e2e": "npm run build && node scripts/run-e2e.mjs",
    "icons": "electron scripts/render-icons.mjs"
  },
  "dependencies": {
    "@betteroffice/docx": "^0.3.0",
    "@betteroffice/docx-react": "^0.3.0",
    "@betteroffice/fonts": "^0.3.0",
    "@betteroffice/pptx": "^0.2.0",
    "@betteroffice/pptx-react": "^0.2.0",
    "@betteroffice/xlsx": "^0.3.0",
    "@betteroffice/xlsx-react": "^0.3.0",
    "@embedpdf/pdfium": "2.15.1",
    "@transcribe/shout": "^1.0.7",
    "@transcribe/transcriber": "^3.0.1",
    "hls.js": "1.6.16",
    "livekit-client": "^2.22.3",
    "node-llama-cpp": "^3.22.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode-generator": "^2.0.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-virtual": "^3.14.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zod": "^4.1.0"
  }
}
