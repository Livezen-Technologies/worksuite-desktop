<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements. JIT is required by V8; nothing else is
  relaxed (no unsigned executable memory beyond JIT, no DYLD variables,
  no library-validation exceptions). Camera and microphone are declared for
  calls (Phase 2) and are still gated by macOS's own permission prompts and
  the app's permission handler.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
